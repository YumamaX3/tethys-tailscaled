# Tethys · runtime configuration  (schema per plan §8.3)
#
# THE single config truth. Hand-editable, and it survives upgrades only because of
# where it lives: Magisk replaces the module directory on every upgrade, so the
# installer seeds this file once to
#
#     /data/adb/tailscale/config.env
#
# and service.sh reads that copy. Edit THAT file. The copy in the module is the
# default template.
#
# READ AS DATA, NEVER SOURCED. scripts/tethys.lib.sh parses KEY=VALUE lines,
# ignores anything that is not an allowlisted key, and never executes a line of
# this file. A config that is `source`d is a config that is a program.
#
# AN EMPTY VALUE MEANS "PASS NOTHING" - it never means "pass zero".

# --- lifecycle --------------------------------------------------------------
# Start the daemon automatically at boot.
TS_START_ON_BOOT="1"

# --- network ----------------------------------------------------------------
# native-first  : try the kernel TUN, fall back to the in-process userspace stack
#                 (--tun=tailscale0,userspace-networking)   <- the design's D3 choice
# native-only   : kernel TUN only (--tun=tailscale0)
# netstack-only : userspace stack only (--tun=userspace-networking)
TS_TUN_MODE="native-first"

# --- daemon -----------------------------------------------------------------
# Flags passed to tailscaled. The patched daemon already defaults
# --no-logs-no-support to true; it is named here so the default is visible.
TS_DAEMON_ARGS="-no-logs-no-support"

# Flags passed to `tailscale up`. Consumed by the up path, not by the daemon
# launch.  [M4]
TS_UP_ARGS="--accept-dns=false"

# Advanced extra `up` arguments. REJECTED at parse time if it contains shell
# metacharacters - see tethys_cfg_load.  [M4]
TS_EXTRA_UP_ARGS=""

# --- identity ---------------------------------------------------------------
# Custom control plane (Headscale). Empty = Tailscale's own.  [M18]
TS_LOGIN_SERVER=""
# Override the getprop-derived hostname. Empty = derive it.  [M18]
TS_HOSTNAME=""
# Active identity profile.  [M18]
TS_PROFILE="default"

# --- sharing ---------------------------------------------------------------
TS_ENABLE_SSH="0"            # adds --ssh            [M14]
TS_ADVERTISE_ROUTES=""       # subnet router         [M14]

# --- routing (advanced) -----------------------------------------------------
# Default OFF by design: a kill switch that strands a phone is a worse failure
# than a leak.  [M16]
TS_KILL_SWITCH="0"
TS_SPLIT_TUNNEL_MODE="off"   # off | include | exclude   [M17]
TS_SPLIT_TUNNEL_UIDS=""      # uid ranges, validated     [M17]

# --- stability / economy ----------------------------------------------------
# Crash recovery. Off by default: a crash loop must never become a power bug.
#   [M19]
TS_WATCHDOG_ENABLED="0"
# performance | balanced | saver   [M9]
TS_POWER_MODE="balanced"

# --- log hygiene ------------------------------------------------------------
# Rotation threshold in KB. Allowed range 128-10240; anything outside it is
# clamped, not obeyed.  [M4]
TS_LOG_MAX_KB="512"

# --- theming ----------------------------------------------------------------
# full-ritual | signature | plain   [M15]
TS_THEME="full-ritual"
TS_JOURNAL_ENABLED="1"       # ritual log   [M15]

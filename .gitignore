# The daemon payload is injected by CI, never committed: a binary in a module
# repo goes stale silently and cannot be reviewed. The installer refuses a zip
# that lacks it, so an empty slot fails loudly rather than shipping quietly.
system/bin/tailscaled
system/bin/tailscale

# The packed artifact, written by tools/pack-module.sh. Never committed: it is a
# build output whose payload comes from CI, and the checksum beside it is only
# meaningful for the exact bytes it was built from.
/dist/

# Where the workflow stages the daemon it downloads from the fork's release, and
# where a local run of the same steps would put it. Acknowledged by the packer,
# never part of the module, never committed.
/payload/

# Local install/test scratch
*.tmp
err.tmp
/.tmp-*/
